{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["DOM", "ES2020"],
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",

		"rootDir": ".",
		"outDir": "./dist",

		"declaration": true,
		"strict": true,
		"skipLibCheck": true,

		"types": ["vitest/globals"],
		"plugins": [{ "name": "typescript-plugin-css-modules" }]
	},
	"include": ["src"]
}
